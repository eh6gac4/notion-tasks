{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "./worker-entry.ts",
	"name": "notion-tasks",
	"compatibility_date": "2026-04-21",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"triggers": {
		// バックログ → 未着手 の自動昇格 (3 日以内 due)。
		// 毎日 0:00 UTC = JST 09:00。1 日 1 回で十分なしきい値 (3 日)。
		"crons": ["0 0 * * *"]
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "notion-tasks"
		}
	],
	"r2_buckets": [
		{
			// Run before first deploy: wrangler r2 bucket create notion-tasks-opennext-cache
			// see https://opennext.js.org/cloudflare/caching
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "notion-tasks-opennext-cache"
		}
	],
	"routes": [
		{
			"pattern": "todo.eh6gac4.work",
			"custom_domain": true
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}