{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "./.open-next/worker.js",
	"name": "notion-tasks",
	"compatibility_date": "2026-04-21",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "notion-tasks"
		}
	],
	"r2_buckets": [
		{
			// Run before first deploy: wrangler r2 bucket create notion-tasks-opennext-cache
			// see https://opennext.js.org/cloudflare/caching
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "notion-tasks-opennext-cache"
		}
		// D1 移行時の添付ファイル置き場。d1_databases と同時に有効化する。
		// ,{
		// 	"binding": "ATTACHMENTS",
		// 	"bucket_name": "notion-tasks-attachments"
		// }
	],
	// D1 移行用。バックエンド切り替え(TASK_STORE=d1)まではコメントアウトのままにする。
	// 有効化する前に:
	//   npx wrangler d1 create notion-tasks
	//   npx wrangler r2 bucket create notion-tasks-attachments
	//   npx wrangler d1 execute notion-tasks --remote --file=./migrations/0001_init.sql
	// 詳細は docs/backend-migration.md
	// "d1_databases": [
	// 	{
	// 		"binding": "DB",
	// 		"database_name": "notion-tasks",
	// 		"database_id": "<wrangler d1 create の出力を貼る>"
	// 	}
	// ],
	"kv_namespaces": [
		{
			// Run before first deploy: wrangler kv namespace create notion-tasks-tokens
			// Gmail の refresh token を保存する。GOOGLE_REFRESH_TOKEN env は
			// KV に値が無い場合の初回ブートストラップ用に残す(src/lib/token-store.ts 参照)。
			"binding": "TOKEN_STORE",
			"id": "e9edef0748424b7da4b4b85c4f4842b5"
		}
	],
	"routes": [
		{
			"pattern": "todo.eh6gac4.work",
			"custom_domain": true
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}