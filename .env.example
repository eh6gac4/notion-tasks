# NextAuth
NEXTAUTH_SECRET=your-secret-here  # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# App credentials
APP_USERNAME=admin
APP_PASSWORD=your-password-here

# Notion
NOTION_TOKEN=your-notion-integration-token
NOTION_DATABASE_ID=b0181e55-5df9-49a5-9790-0ac7e50057f9

# Gmail (OAuth クライアント。refresh token は初回のみ手動発行し、以降は /mail の
# 再連携ボタン経由で Cloudflare KV(TOKEN_STORE) に自動保存される)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-initial-refresh-token

# タスクの保存先バックエンド。未設定なら notion (dev では in-memory mock)。
# "d1" にすると Cloudflare D1 + R2 を使う (docs/backend-migration.md 参照)。
TASK_STORE=notion
